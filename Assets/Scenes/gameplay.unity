  _questPanel: {fileID: 536973024}
  _quest:
  - QuestName_EN: 'Quest1: Inspect the room'
    QuestName_RU: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 1: \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    QuestSteps_EN:
    - '[1] Read your notebook'
    - '[2] Find your gun in shelf'
    QuestSteps_RU:
    - "[1] \u041F\u0440\u043E\u0447\u0442\u0438\u0442\u0435 \u0441\u0432\u043E\u0439
      \u0431\u043B\u043E\u043A\u043D\u043E\u0442"
    - "[2] \u041D\u0430\u0439\u0434\u0438 \u0441\u0432\u043E\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442"
    CompletedSteps: 0000
  - QuestName_EN: 'Quest2: Conduct an interrogation'
    QuestName_RU: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 2: \u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0434\u043E\u043F\u0440\u043E\u0441"
    QuestSteps_EN:
    - '[1] Wait for suspect'
    - '[2] Turn ON device'
    - '[3] Ask questions'
    - '[4] Make your decision'
    QuestSteps_RU:
    - "[1] \u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E"
    - "[2] \u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E"
    - "[3] \u0417\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B"
    - "[4] \u041F\u0440\u0438\u043C\u0438\u0442\u0435 \u0441\u0432\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    CompletedSteps: 00000000
  - QuestName_EN: 'Quest3: Kill him before he kills you'
    QuestName_RU: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 3: \u0423\u0431\u0435\u0439\u0442\u0435
      \u0435\u0433\u043E \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u043E\u043D \u0443\u0431\u044C\u0435\u0442 \u0432\u0430\u0441"
    QuestSteps_EN:
    - '[1] Take a gun'
    - '[2] Shoot'
    QuestSteps_RU:
    - "[1] \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442"
    - "[2] \u0421\u0442\u0440\u0435\u043B\u044F\u0439\u0442\u0435"
    CompletedSteps: 0000
  - QuestName_EN: 'Quest4: Let him go'
    QuestName_RU: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 4: \u041E\u0442\u043F\u0443\u0441\u0442\u0438
      \u0435\u0433\u043E"
    QuestSteps_EN:
    - '[1] Ask him to leave'
    QuestSteps_RU:
    - "[1] \u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435 \u0435\u0433\u043E
      \u0443\u0439\u0442\u0438"
    CompletedSteps: 00
