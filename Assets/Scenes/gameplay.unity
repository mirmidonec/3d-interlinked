  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'During each interrogation, ask psychological questions designed to provoke
    natural human emotional responses, such as fear, stress, empathy, or confusion.
    Carefully monitor the subject''s biometric reactions to identify potential anomalies.


    -
    <color=yellow>Pupil Response:</color> Observe pupil dilation and constriction.
    Unnatural, absent, or delayed reactions may indicate abnormal behavior.


    -
    <color=yellow>Pulse:</color> Monitor heart rate for sudden spikes, drops, or
    a lack of expected changes during emotional stimuli.


    - <color=yellow>Response
    Time:</color> Record delays between questions and answers. Unusually long pauses
    or instant, mechanically consistent responses may be suspicious.


    Compare
    all recorded reactions with expected human responses. Consistent deviations across
    multiple indicators may suggest that the subject is not human.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f75afadabff8894cb58c69272a4b20b, type: 2}
  m_sharedMaterial: {fileID: 5402434675917719855, guid: 2f75afadabff8894cb58c69272a4b20b, type: 2}
