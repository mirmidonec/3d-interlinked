    m_Metadata:
      m_Items: []
  - m_Id: 18639426359296
    m_Localized: "<size=150%><b>[\u0420\u0423\u041A\u041E\u0412\u041E\u0414\u0421\u0422\u0412\u041E
      \u041F\u041E \u041E\u041F\u0415\u0420\u0410\u0426\u0418\u042F\u041C \u041F\u041E\u041B\u0418\u0426\u0418\u0418
      \u2014 \u0424\u0410\u0419\u041B 77-42]</size>\r\n<size=150%>\u041A\u0420\u0410\u0422\u041A\u0418\u0419
      \u0418\u041D\u0422\u0415\u0420\u0410\u041A\u0422\u0418\u0412\u041D\u042B\u0419
      \u041A\u041E\u041D\u0422\u0420\u041E\u041B\u042C - 2064 \u0413\u041E\u0414</size>\r\n\r\n<size=120%>\u0414\u0415\u041F\u0410\u0420\u0422\u0410\u041C\u0415\u041D\u0422
      \u041F\u041E\u0412\u0415\u0414\u0415\u041D\u0427\u0415\u0421\u041A\u041E\u0413\u041E
      \u0410\u041D\u0410\u041B\u0418\u0417\u0410 \u0418 \u0412\u041E\u0421\u0421\u0422\u0410\u041D\u041E\u0412\u041B\u0415\u041D\u0418\u042F
      \u041F\u0410\u041C\u042F\u0422\u0418</b></size>\r\n<b><size=150%>\u0420\u0410\u0417\u0414\u0415\u041B
      I: \u041E\u0411\u0429\u0410\u042F \u0414\u0418\u0420\u0415\u041A\u0422\u0418\u0412\u0410</size></b>\r\n\r\n<size=120%>\u0414\u0430\u043D\u043D\u043E\u0435
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0432\u044B\u0434\u0430\u0435\u0442\u0441\u044F
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0443 \u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0445
      \u041E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u043F\u0440\u0438 \u041C\u0438\u043D\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0435
      \u0418\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438
      \u0438 \u041F\u043E\u0432\u0435\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044F. \u041F\u0435\u0440\u0435\u0434
      \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u043E\u0439 \u0432 \u0437\u043E\u043D\u0443
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0430\u0433\u0435\u043D\u0442\u044B
      \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u0438\u0437\u0443\u0447\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u043D\u044B\u0435
      \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u044B
      \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u0441\u0438\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0441\u0440\u0435\u0434\u044B. \u041D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430 \u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043A \u0434\u0435\u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u0438
      \u0432 \u043F\u043E\u043B\u0435 \u0438\u043B\u0438 \u043F\u043E\u0442\u0435\u0440\u0435
      \u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0439 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438.</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 18651027804160
    m_Localized: "\n<b><size=120%>\u0421\u0425\u0415\u041C\u0410 \u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u042F
      \u041F\u041E\u041B\u0415\u0412\u042B\u041C \u0410\u0413\u0415\u041D\u0422\u041E\u041C</b></size>\r\n\r\n<size=120%><b>Z
      - \u041F\u0420\u0418\u0411\u041B\u0418\u0417\u0418\u0422\u042C</b></size>\r\n\u0420\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0439\u0442\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u0432\u0431\u043B\u0438\u0437\u0438.
      \u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u043D\u043E\u0433\u043E
      \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0430\u043D\u0430\u043B\u0438\u0437\u0430.\r\n\n<size=120%><b>\u041B\u041A\u041C
      - \u0412\u0417\u0410\u0418\u041C\u041E\u0414\u0415\u0419\u0421\u0422\u0412\u0418\u0415
      / \u041F\u0420\u041E\u041F\u0423\u0421\u041A / \u0412\u042B\u0421\u0422\u0420\u0415\u041B</b></size>\r\n\u041E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0439\u0442\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442\u044B, \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0439\u0442\u0435
      \u0432\u044B\u0432\u043E\u0434 \u0440\u0435\u043F\u043B\u0438\u043A \u0438\u043B\u0438
      \u0441\u0442\u0440\u0435\u043B\u044F\u0439\u0442\u0435 (\u0435\u0441\u043B\u0438
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u043E).\r\n\n<size=120%><b>\u041F\u041A\u041C
      - \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u0422\u042C
      / \u041F\u0415\u0420\u0415\u041B\u0418\u0421\u0422\u041D\u0423\u0422\u042C</b></size>\r\n\u041A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u043D\u044B\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. \u041F\u0435\u0440\u0435\u043B\u0438\u0441\u0442\u044B\u0432\u0430\u043D\u0438\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u0438\u043B\u0438
      \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u0441 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438.\r\n\n<size=120%><b>Q
      - \u041F\u041E\u041B\u041E\u0416\u0418\u0422\u042C \u041F\u0420\u0415\u0414\u041C\u0415\u0422/
      \u0412\u042B\u0419\u0422\u0418 \u0418\u0417 \u041F\u041A</b></size>\r\n\u0412\u0435\u0440\u043D\u0438\u0442\u0435
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u043D\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E.\r\n\n<size=120%><b>WASD
      - \u0414\u0412\u0418\u0416\u0415\u041D\u0418\u0415</b></size>\r\n\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435
      \u043F\u043E \u0441\u0440\u0435\u0434\u0435. \u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0435
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C
      \u0430\u0433\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18661794582528
    m_Localized: "\n<b><size=150%>\u0420\u0410\u0417\u0414\u0415\u041B II: \u041F\u0420\u041E\u0422\u041E\u041A\u041E\u041B
      \u0412\u0415\u0420\u0418\u0424\u0418\u041A\u0410\u0426\u0418\u0418 \u041F\u041E\u0414\u041E\u0417\u0420\u0415\u0412\u0410\u0415\u041C\u041E\u0413\u041E</size></b>\n\n\u041F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430
      \u043F\u0440\u043E\u0441\u0442\u0430: \u043D\u0430\u0447\u043D\u0438\u0442\u0435
      \u0434\u043E\u043F\u0440\u043E\u0441  \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430
      \u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0445
      \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432.\n\n\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0431\u0438\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438:\n\u2022 <b>\u0417\u0430\u0434\u0435\u0440\u0436\u043A\u0430
      \u043E\u0442\u0432\u0435\u0442\u0430</b> \u2014 \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u0430\u044F
      \u043F\u0430\u0443\u0437\u0430 \u043C\u043E\u0436\u0435\u0442 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u0443\u044E \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0443.\n\u2022
      <b>\u0418\u0437\u043C\u0435\u043D\u0447\u0438\u0432\u043E\u0441\u0442\u044C
      \u043F\u0443\u043B\u044C\u0441\u0430</b> \u2014 \u0440\u0435\u0437\u043A\u0438\u0435
      \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F \u043C\u043E\u0433\u0443\u0442
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u043E \u043F\u043B\u043E\u0445\u043E\u043C \u0438\u043C\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438
      \u044D\u043C\u043E\u0446\u0438\u0439 \u0438\u043B\u0438 \u043E \u0432\u044B\u0441\u043E\u043A\u043E\u0439
      \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u0438 \u043A \u0441\u0442\u0440\u0435\u0441\u0441\u0443.\n\u2022
      <b>\u0420\u0435\u0430\u043A\u0446\u0438\u044F \u0437\u0440\u0430\u0447\u043A\u043E\u0432</b>
      \u2014 \u043D\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435 \u0438\u043B\u0438
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0440\u0435\u0430\u043A\u0446\u0438\u0438
      \u2014 \u043C\u0430\u0440\u043A\u0435\u0440 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E
      \u0440\u0438\u0441\u043A\u0430.\n\n\u0424\u0438\u043A\u0441\u0438\u0440\u0443\u0439\u0442\u0435
      \u0432\u0441\u0435 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0438.\n\u041F\u043E\u043C\u0435\u0447\u0430\u0439\u0442\u0435
      \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u044B\u0445,
      \u0443 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442\u0441\u044F
      \u0441\u0442\u043E\u0439\u043A\u043E\u0435 \u043D\u0435\u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435
      \u043C\u0435\u0436\u0434\u0443 \u0432\u0435\u0440\u0431\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u043E\u0442\u0432\u0435\u0442\u0430\u043C\u0438 \u0438 \u0431\u0438\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0440\u0435\u0430\u043A\u0446\u0438\u0435\u0439.\n\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435:
      \u0420\u0435\u043F\u043B\u0438\u043A\u0430\u043D\u0442\u044B \u043C\u043E\u0433\u0443\u0442
      \u0438\u043C\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043B\u043E\u0433\u0438\u043A\u0443,
      \u043D\u043E \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u044E\u0442 \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0438
      \u0441 \u0445\u0430\u043E\u0442\u0438\u0447\u043D\u044B\u043C\u0438 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u043E\u0442\u0442\u0435\u043D\u043A\u0430\u043C\u0438. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u044D\u0442\u043E."
    m_Metadata:
